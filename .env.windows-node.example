# Windows Docker host — USST blockchain node
# Copy to .env on the Windows machine running docker-compose.windows-node.yml

USST_CHAIN_ID=778889

# Geth signer — must match the Clique sealer in chain/genesis.json extradata.
# Generate with: python scripts/create-miner-wallet.py
USST_SIGNER_KEY=0xYOUR_SIGNER_PRIVATE_KEY_HERE
USST_SIGNER_ADDRESS=0xYOUR_SIGNER_ADDRESS_HERE

# Contract deployer — used by deploy.py to send the initial pool funds.
# Can be the same as the signer or a separate funded wallet.
USST_DEPLOYER_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# Mining pool size deposited at deploy (USST)
USST_FUND_ETHER=10000

# Published on all interfaces (WireGuard + Docker port mapping)
USST_RPC_PORT=8545
USST_WS_PORT=8546
USST_P2P_PORT=30303

# MetaMask on this PC
USST_RPC_PUBLIC=http://127.0.0.1:8545

# Public RPC for remote miners (VPS public IP — DNAT to this host)
# USST_RPC_PUBLIC=http://YOUR_VPS_PUBLIC_IP:8545
