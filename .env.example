# UST Network — Docker environment
# Copy to .env and change keys before production use.

USST_CHAIN_ID=778889

# Geth signer — must match the Clique sealer in chain/genesis.json extradata.
# Generate: python scripts/create-miner-wallet.py
USST_SIGNER_KEY=0xYOUR_SIGNER_PRIVATE_KEY_HERE
USST_SIGNER_ADDRESS=0xYOUR_SIGNER_ADDRESS_HERE

# Contract deployer — used to fund the mining pool at deploy time.
USST_DEPLOYER_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# Miner wallet — receives USST rewards (unique per machine).
# Generate: python scripts/create-miner-wallet.py
USST_MINER_KEY=0xYOUR_MINER_PRIVATE_KEY_HERE

# Mining pool size deposited at deploy (USST)
USST_FUND_ETHER=10000

# Host ports exposed by the node container
USST_RPC_PORT=8545
USST_WS_PORT=8546
USST_P2P_PORT=30303

# Public RPC URL for MetaMask (use your server IP/domain in production)
USST_RPC_PUBLIC=http://127.0.0.1:8545

# ── Bridge (optional) ──────────────────────────────────────────────────────
# Required only if running the USDT bridge relayer (scripts/bridge-relayer.py)
#
# ⚠️  SECURITY RULES — read before setting these values:
#
#  1. BRIDGE_OPERATOR_KEY must be a UNIQUE key, never shared with any other
#     service. DO NOT reuse USST_DEPLOYER_KEY or USST_SIGNER_KEY here.
#     Generate a dedicated key: python -c "import secrets; print('0x'+secrets.token_hex(32))"
#
#  2. BRIDGE_TREASURY_ADDRESS is public — it receives real ETH/USDT on Ethereum
#     mainnet. Keep only the minimum ETH needed for gas (~0.01 ETH ≈ 10 txs).
#     Never store large amounts there.
#
#  3. Never commit .env to git. Never paste private keys in terminal history,
#     chat logs, or Docker exec commands visible to others.
#
#  4. If this key is ever compromised (stolen), immediately:
#     a) Run scripts/transfer-operator.py with a new key to revoke access
#     b) Update BRIDGE_OPERATOR_KEY and BRIDGE_TREASURY_ADDRESS here
#     c) Restart the bridge-relayer container
#
# BRIDGE_OPERATOR_KEY=0xYOUR_DEDICATED_BRIDGE_OPERATOR_KEY
# BRIDGE_TREASURY_ADDRESS=0xYOUR_DEDICATED_BRIDGE_TREASURY_ADDRESS
# BRIDGED_USDT_ADDRESS=0xDEPLOYED_BRIDGED_USDT_ADDRESS
# ETH_RPC=https://ethereum.publicnode.com   # or Infura/Alchemy endpoint
#
# Optional thresholds:
# BRIDGE_ETH_WARN=0.005    # warn in logs when ETH drops below this (default: 0.005)
# BRIDGE_ETH_PAUSE=0.0005  # pause withdrawals when ETH drops below this (default: 0.0005)

# GPU mining flags
# USST_GPU=1              (default: 1 — use GPU; 0 = force CPU)
# USST_GPU_REQUIRED=0     (default: 0 — fall back to CPU if GPU unavailable; 1 = hard fail)
# USST_GPU_BATCH_SIZE=    (default: auto by VRAM — 512M for 8GB, 1B for 16GB+ GPU)
# USST_CPU_BATCH_SIZE=    (default: cpu_count * 25000 hashes per CPU batch)
