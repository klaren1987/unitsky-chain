# Worker machine — connect to remote USST node
# Copy to .env on each mining PC (unique USST_MINER_KEY per machine)

# RPC of the USST node. From Docker on Windows use host.docker.internal:8545
USST_RPC=http://host.docker.internal:8545

USST_CHAIN_ID=778889

# Contract address from server (docker compose logs deploy, or deployed.json on server)
USST_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Unique private key for THIS computer (generate: python scripts/create-miner-wallet.py)
USST_MINER_KEY=0xYOUR_UNIQUE_PRIVATE_KEY_HERE

# GPU mining. Set USST_GPU=0 to force CPU.
USST_GPU=1
# USST_GPU_REQUIRED=1  # Uncomment to fail hard if no GPU detected
# USST_GPU_BATCH_SIZE=134217728  # Auto by VRAM if unset (RTX 4060 ~128M)
# USST_GPU_STREAMS=2             # Parallel CUDA streams (2 is optimal on most GPUs)
# USST_GPU_THREADS=256           # Threads per block (256 is best for Keccak kernel)
# USST_GPU_UI_INTERVAL=0.25      # Seconds between dashboard updates (GPU mode)
# USST_CPU_BATCH_SIZE=           # Hashes per CPU batch (default: cpu_count * 25000)
