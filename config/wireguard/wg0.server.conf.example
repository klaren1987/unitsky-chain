# WireGuard server — copy to /etc/wireguard/wg0.conf on the Linux VPS.
# Replace placeholders: SERVER_PRIVATE_KEY, CLIENT_PUBLIC_KEY.
# Change eth0 below if your public interface has another name (ip -o link show).
#
# Architecture:
#   Internet :8545/:8546/:30303  →  VPS (eth0)  →  DNAT  →  Windows (10.13.13.2) Docker node

[Interface]
Address = 10.13.13.1/24
ListenPort = 51820
PrivateKey = SERVER_PRIVATE_KEY
MTU = 1420
SaveConfig = false

# Routing + firewall + port forward to Windows USST node
PostUp = sysctl -w net.ipv4.ip_forward=1
PostUp = iptables -A INPUT -i eth0 -p udp --dport 51820 -j ACCEPT
PostUp = iptables -A INPUT -i eth0 -p tcp --dport 80 -j ACCEPT
PostUp = iptables -A INPUT -i eth0 -p tcp --dport 443 -j ACCEPT
PostUp = iptables -t nat -A PREROUTING -i eth0 -p tcp --dport 8545 -j DNAT --to-destination 10.13.13.2:8545
PostUp = iptables -t nat -A PREROUTING -i eth0 -p tcp --dport 8546 -j DNAT --to-destination 10.13.13.2:8546
PostUp = iptables -t nat -A PREROUTING -i eth0 -p tcp --dport 30303 -j DNAT --to-destination 10.13.13.2:30303
PostUp = iptables -t nat -A PREROUTING -i eth0 -p tcp --dport 80 -j DNAT --to-destination 10.13.13.2:80
PostUp = iptables -t nat -A PREROUTING -i eth0 -p tcp --dport 443 -j DNAT --to-destination 10.13.13.2:443
PostUp = iptables -A FORWARD -i eth0 -o wg0 -j ACCEPT
PostUp = iptables -A FORWARD -i wg0 -o eth0 -m state --state RELATED,ESTABLISHED -j ACCEPT
PostUp = iptables -t nat -A POSTROUTING -o wg0 -j MASQUERADE

PostDown = iptables -t nat -D PREROUTING -i eth0 -p tcp --dport 8545 -j DNAT --to-destination 10.13.13.2:8545
PostDown = iptables -t nat -D PREROUTING -i eth0 -p tcp --dport 8546 -j DNAT --to-destination 10.13.13.2:8546
PostDown = iptables -t nat -D PREROUTING -i eth0 -p tcp --dport 30303 -j DNAT --to-destination 10.13.13.2:30303
PostDown = iptables -t nat -D PREROUTING -i eth0 -p tcp --dport 80 -j DNAT --to-destination 10.13.13.2:80
PostDown = iptables -t nat -D PREROUTING -i eth0 -p tcp --dport 443 -j DNAT --to-destination 10.13.13.2:443
PostDown = iptables -D FORWARD -i eth0 -o wg0 -j ACCEPT
PostDown = iptables -D FORWARD -i wg0 -o eth0 -m state --state RELATED,ESTABLISHED -j ACCEPT
PostDown = iptables -t nat -D POSTROUTING -o wg0 -j MASQUERADE
PostDown = iptables -D INPUT -i eth0 -p udp --dport 51820 -j ACCEPT
PostDown = iptables -D INPUT -i eth0 -p tcp --dport 80 -j ACCEPT
PostDown = iptables -D INPUT -i eth0 -p tcp --dport 443 -j ACCEPT
PostDown = sysctl -w net.ipv4.ip_forward=0

# Windows host running the USST blockchain node in Docker
[Peer]
PublicKey = CLIENT_PUBLIC_KEY
AllowedIPs = 10.13.13.2/32
PersistentKeepalive = 25
