# Wildcard cert via DNS-01 (Timeweb) — covers ALL *.byteboost.ru subdomains
# No need to list individual domains. One cert for everything.
*.byteboost.ru {
	encode gzip
	tls {
		dns timeweb {env.TIMEWEB_API_TOKEN}
	}
	reverse_proxy byteboost-sites:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}